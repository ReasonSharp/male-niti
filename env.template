#!/bin/bash

### ENVIRONMENT (prod, dev) ###
ENV="${ENV}"

### SERVER ###
WEB_SERVER_NAME="${WEB_SERVER_NAME}"
ALL_DOMAINS="${ALL_DOMAINS}"
ADMIN_EMAIL="${ADMIN_EMAIL}"
RSA_KEY_SIZ=${RSA_KEY_SIZ}
DNS_CRED_FULL_PATH="${DNS_CRED_FULL_PATH}"
DNH_DNS_CRED_FULL_PATH="${DNH_DNS_CRED_FULL_PATH}"
HOSTNAME="${HOSTNAME}"

### DATABASE ###
DB_HOST="${DB_HOST}"
DB_PORT=${DB_PORT}
DB_NAME="${DB_NAME}"
DB_USER="${DB_USER}"
DB_PASS="${DB_PASS}"
DNH_DB_PASS="${DNH_DB_PASS}"
DNH_API_DB_PASS="${DNH_API_DB_PASS}"

### API ###
ATODO_JWT_SECRET="${ATODO_JWT_SECRET}"
# atodo's own reachable base URL, e.g. https://atodo.maleniti.com in prod or
# http://localhost:50007 in dev - api embeds this (plus a `verify` query
# param) as the clickable link in registration verification emails.
ATODO_FRONTEND_BASE_URL="${ATODO_FRONTEND_BASE_URL}"

### ATODO ###
UNSPLASH_ACCESS_KEY="${UNSPLASH_ACCESS_KEY}"
# Leave empty in prod: atodo's frontend then defaults to a same-origin
# /atodo/v1, which nginx proxies to the api service (see tlsoffloader.conf's
# atodo.maleniti.com block). Only needed when atodo is reached directly on
# its own port instead of through nginx, e.g. http://localhost:50000 in dev.
API_BASE_URL="${API_BASE_URL}"
