#!/bin/bash

### ENVIRONMENT (prod, dev) ###
ENV="${ENV}"

### SERVER ###
WEB_SERVER_NAME="${WEB_SERVER_NAME}"
ALL_DOMAINS="${ALL_DOMAINS}"
ADMIN_EMAIL="${ADMIN_EMAIL}"
RSA_KEY_SIZ=${RSA_KEY_SIZ}
DNS_CRED_FULL_PATH="${DNS_CRED_FULL_PATH}"
DNH_DNS_CRED_FULL_PATH="${DNH_DNS_CRED_FULL_PATH}"
HOSTNAME="${HOSTNAME}"

### DATABASE ###
DB_HOST="${DB_HOST}"
DB_PORT=${DB_PORT}
DB_NAME="${DB_NAME}"
DB_USER="${DB_USER}"
DB_PASS="${DB_PASS}"
DNH_DB_PASS="${DNH_DB_PASS}"
DNH_API_DB_PASS="${DNH_API_DB_PASS}"

### API ###
ATODO_JWT_SECRET="${ATODO_JWT_SECRET}"
# atodo's own reachable base URL, e.g. https://atodo.maleniti.com in prod or
# http://localhost:50007 in dev - api embeds this (plus a `verify` query
# param) as the clickable link in registration verification emails.
ATODO_FRONTEND_BASE_URL="${ATODO_FRONTEND_BASE_URL}"
# Outgoing email (registration verification, login-email change links) over
# SMTP. Leave ATODO_SMTP_HOST empty to only log emails in the api's output
# instead of sending them. For the Zoho-hosted noreply@maleniti.com:
# ATODO_SMTP_HOST=smtp.zoho.eu (or smtp.zoho.com, per the account's data
# centre), ATODO_SMTP_PORT=465, ATODO_SMTP_USER = the Zoho mailbox that owns
# the noreply address (itself or as an alias), ATODO_SMTP_PASS = an
# app-specific password generated for it in Zoho Accounts > Security.
ATODO_SMTP_HOST="${ATODO_SMTP_HOST}"
ATODO_SMTP_PORT=${ATODO_SMTP_PORT}
ATODO_SMTP_USER="${ATODO_SMTP_USER}"
ATODO_SMTP_PASS="${ATODO_SMTP_PASS}"
ATODO_MAIL_FROM="${ATODO_MAIL_FROM}"
# Where payment problems needing a person go (disputes, failed refunds).
ATODO_OWNER_EMAIL="${ATODO_OWNER_EMAIL}"
# Payments (Stripe) -- all three needed, or checkout is refused. What's sold,
# and at what price, comes from the database: ATODO_BRAND is the brand code
# (maleniti.brand, e.g. atodo) whose subscription products checkout sells -
# each with its Stripe product ID and price, set in the admin app.
STRIPE_SECRET_KEY="${STRIPE_SECRET_KEY}"
STRIPE_WEBHOOK_SECRET="${STRIPE_WEBHOOK_SECRET}"
ATODO_BRAND="${ATODO_BRAND}"
# Croatian B2C fiscalization of every payment -- with live Stripe keys, the api
# refuses payments altogether without a usable certificate for the production
# service; with test keys, payments work regardless (receipts fiscalized only
# against the test service, skipped without a certificate). FISCAL_CERT_P12_BASE64 = the FINA .p12
# file base64-encoded on one line (base64 -w0 cert.p12); FISCAL_CIS_URL empty =
# the TEST service, set https://cis.porezna-uprava.hr:8449/FiskalizacijaService
# only with a production certificate. See male-niti-api/lib/atodo/fiscal/config.js.
FISCAL_CERT_P12_BASE64="${FISCAL_CERT_P12_BASE64}"
FISCAL_CERT_PASSWORD="${FISCAL_CERT_PASSWORD}"
FISCAL_CIS_URL="${FISCAL_CIS_URL}"
FISCAL_CIS_CA_BASE64="${FISCAL_CIS_CA_BASE64}"
FISCAL_OIB="${FISCAL_OIB}"
FISCAL_PREMISES="${FISCAL_PREMISES}"
FISCAL_DEVICE="${FISCAL_DEVICE}"
FISCAL_OPERATOR_OIB="${FISCAL_OPERATOR_OIB}"
FISCAL_SELLER_NAME="${FISCAL_SELLER_NAME}"
FISCAL_SELLER_ADDRESS="${FISCAL_SELLER_ADDRESS}"
FISCAL_VAT_NOTE="${FISCAL_VAT_NOTE}"

### ATODO ###
UNSPLASH_ACCESS_KEY="${UNSPLASH_ACCESS_KEY}"
# Leave empty in prod: atodo's frontend then defaults to a same-origin
# /atodo/v1, which nginx proxies to the api service (see tlsoffloader.conf's
# atodo.maleniti.com block). Only needed when atodo is reached directly on
# its own port instead of through nginx, e.g. http://localhost:50000 in dev.
API_BASE_URL="${API_BASE_URL}"
