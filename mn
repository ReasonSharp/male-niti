#!/bin/bash

immediateExit=0
if [ ! -f ./.env ]; then
 immediateExit=1
fi

set -a && . ./.env && set +a
envsubst < "./env.template" > "./.env"

if [ "${immediateExit}" -eq 1 ]; then
 echo ".env file created; edit it to configure the platform"
 exit 0
fi

PREFIX=mn
API_FOLDER=api
WWW_FOLDER=www
ADMIN_FOLDER=admin
ATODO_FOLDER=atodo
export API_CONTAINER=${PREFIX}-${API_FOLDER}
export WWW_CONTAINER=${PREFIX}-${WWW_FOLDER}
export ADMIN_CONTAINER=${PREFIX}-${ADMIN_FOLDER}
export ATODO_CONTAINER=${PREFIX}-${ATODO_FOLDER}
mkdir -p ./files/config
if [ -z "${DNS_CRED_FULL_PATH}" ]; then
	export DNS_CREDENTIALS=
else
 cp "${DNS_CRED_FULL_PATH}" ./files/config/
 export DNS_CREDENTIALS=./files/config/$(basename "${DNS_CRED_FULL_PATH}")
fi
# dnh.hr's DNS zone lives in a separate GCP project from the platform's own
# domains, so it needs its own dns-google service account credentials
if [ -z "${DNH_DNS_CRED_FULL_PATH}" ]; then
	export DNH_DNS_CREDENTIALS=
else
 cp "${DNH_DNS_CRED_FULL_PATH}" "./files/config/dnh-$(basename "${DNH_DNS_CRED_FULL_PATH}")"
 export DNH_DNS_CREDENTIALS=./files/config/dnh-$(basename "${DNH_DNS_CRED_FULL_PATH}")
fi

# platform-integration/{config.template,cfgloc} is a service repo's own
# contract with whatever platform deploys it, not something this platform
# owns - config.template is filled in from this platform's .env vars via
# envsubst, cfgloc is the single-line in-container path to bind-mount the
# result to. Renders into files/config/<folder>/ and exports
# <PREFIX>_CFG_SRC / <PREFIX>_CFG_DST for docker-compose.yml to bind-mount.
# Services whose repo doesn't provide a platform-integration/ folder are
# left alone. Call again after clone-or-pull so a freshly pulled contract
# takes effect immediately, not just on the next unrelated mn invocation.
deliver-config() {
 folder="${1}"
 varprefix="${2}"
 tmpl="containers/${folder}/platform-integration/config.template"
 cfgloc="containers/${folder}/platform-integration/cfgloc"
 if [ ! -f "${tmpl}" ] || [ ! -f "${cfgloc}" ]; then
  return
 fi
 dst=$(cat "${cfgloc}")
 mkdir -p "files/config/${folder}"
 src="files/config/${folder}/$(basename "${dst}")"
 envsubst < "${tmpl}" > "${src}"
 export "${varprefix}_CFG_SRC"="./${src}"
 export "${varprefix}_CFG_DST"="${dst}"
 # some Dockerfiles (e.g. api's) COPY their env file into the image at build
 # time, so it also needs to sit in the build context itself, not just be
 # bind-mounted at runtime - keep both copies in sync from the same render
 cp "${src}" "containers/${folder}/$(basename "${dst}")"
}

# dnh-web is a bolted-on site, not one of this platform's own services, so
# it has no platform-integration/ contract of its own; render its .env
# straight from a template this repo owns, since the mariadb creds it needs
# already live in this platform's .env. Must run after every (re)clone of
# dnh-www and before anything brings the dnh container up.
deliver-dnh-config() {
 envsubst < "containers/dnh-www.env.template" > "containers/dnh-www/.env"
}

deliver-config "${API_FOLDER}" API
# every docker compose invocation parses the whole file, and docker-compose.yml
# references ${ATODO_CFG_SRC}/${ATODO_CFG_DST} unconditionally (same reason
# api's own call above runs on every invocation, not just build-platform/
# update atodo)
deliver-config "${ATODO_FOLDER}" ATODO

clone-or-pull() {
 if [ -z "${1}" ] || [ -z "${2}" ]; then
  echo "clone-or-pull: missing parameter"
  exit 1
 fi
 link="${1}"
 path="${2}"
 branch="${3}"
 if [ ! -d "./${path}" ]; then
  if [ -z "${branch}" ]; then
   git clone "${link}" "${path}"
  else
   git clone -b "${branch}" "${link}" "${path}"
  fi
 else
 	prevPath=`pwd`
  cd "${path}"
  echo -n "${path}: "
  git pull
  cd "${prevPath}"
 fi
}


# ---------------------------------------------------------------------------
# Versioned deploys of the platform's own services (api, www, admin, atodo).
#
# A release is a version yyyy.MM.dd.x, tagged with that same name in every
# service repo (and this one); `./mn deploy <version>` builds exactly those
# tags. Without a version it deploys each repo's main branch as
# "dev-<timestamp>" -- same steps, for development. Images are tagged with
# the version (docker-compose.yml uses ${MN_VERSION}), so the previous
# release's images stay around for `./mn rollback`.
#
# The database schema is versioned too: the api repo's db/migrations/, run
# by dbupdater's pgupgrade/pgdowngrade (https://github.com/maleniti/dbupdater).
# A deploy that needs migrations switches maintenance mode on (nginx answers
# every page/API request with "being updated"), stops the api, backs the
# database up, migrates -- each version one transaction, so a failure
# changes nothing and the old release simply comes back -- then starts the
# new release and waits for its /health to confirm the api and database
# versions match before switching maintenance off.
# ---------------------------------------------------------------------------

PLATFORM_SERVICES=(api www admin atodo)
DBUPDATER_FOLDER=dbupdater
DBUPDATER_REPO=git@github.com:maleniti/dbupdater.git
DB="${DB_NAME:-postgres}"
MIGRATIONS="containers/${API_FOLDER}/db/migrations"
VERSION_FILE=files/deployed-version
PREVIOUS_VERSION_FILE=files/previous-version
DEPLOY_LOG=files/deploy-history.log
MAINTENANCE_DIR=files/maintenance
BACKUP_DIR=files/backups
HEALTH_URL=http://127.0.0.1:50000/health

export MN_VERSION=$(cat "${VERSION_FILE}" 2>/dev/null || echo latest)

# The maintenance page and status file nginx serves (see
# containers/nginx/tlsoffloader.conf), kept current on every invocation.
mkdir -p "${MAINTENANCE_DIR}"
cp ./containers/nginx/maintenance.html "${MAINTENANCE_DIR}/_maintenance.html"
[ -f "${MAINTENANCE_DIR}/status.json" ] || echo '{}' > "${MAINTENANCE_DIR}/status.json"

dc() {
 docker compose -p mb-platform -f docker-compose.yml "${@}"
}

die() {
 echo "${0}: ${*}" >&2
 exit 1
}

log-deploy() {
 echo "$(date '+%Y-%m-%d %H:%M:%S') ${*}" >> "${DEPLOY_LOG}"
}

service-info() {
 case "${1}" in
  api)   folder="${API_FOLDER}";   image="${API_CONTAINER}";   repo="git@github.com:ReasonSharp/male-niti-api.git";;
  www)   folder="${WWW_FOLDER}";   image="${WWW_CONTAINER}";   repo="git@github.com:ReasonSharp/male-niti-web.git";;
  admin) folder="${ADMIN_FOLDER}"; image="${ADMIN_CONTAINER}"; repo="git@github.com:ReasonSharp/male-niti-admin.git";;
  atodo) folder="${ATODO_FOLDER}"; image="${ATODO_CONTAINER}"; repo="git@github.com:maleniti/atodo.git";;
  *) return 1;;
 esac
}

# Checks containers/<folder> out at a release tag, or at its remote default
# branch's head when no tag is given. These are deploy-only clones: any
# local change in them is discarded.
sync-source() {
 local repo="${1}" folder="${2}" tag="${3}" branch
 if [ ! -d "containers/${folder}/.git" ]; then
  rm -rf "containers/${folder}"
  git clone -q "${repo}" "containers/${folder}" || return 1
 fi
 git -C "containers/${folder}" fetch -q --tags --force origin || return 1
 if [ -n "${tag}" ]; then
  git -C "containers/${folder}" checkout -q --force "refs/tags/${tag}" 2>/dev/null \
   || { echo "${0}: ${folder} has no tag ${tag}" >&2; return 1; }
 else
  git -C "containers/${folder}" remote set-head -a origin >/dev/null 2>&1
  branch=$(git -C "containers/${folder}" symbolic-ref --short refs/remotes/origin/HEAD) || return 1
  git -C "containers/${folder}" checkout -q --force -B "${branch#origin/}" "${branch}" || return 1
 fi
 echo "${folder}: $(git -C "containers/${folder}" log -1 --format='%h %s')"
}

wait-for-db() {
 dc up -d db
 echo -n "${0}: waiting for db to accept connections"
 local tries=0
 until dc exec -T db pg_isready -U postgres >/dev/null 2>&1; do
  echo -n "."
  tries=$((tries + 1))
  [ "${tries}" -ge 60 ] && { echo " timed out"; exit 1; }
  sleep 1
 done
 echo " ready"
 # POSTGRES_PASSWORD only takes effect on first-time initdb, so on a data
 # dir that predates this container (or ${DB_PASS} changing since) the
 # actual role password can drift from .env. Keep it in sync on every run,
 # using the trusted local socket connection rather than the (possibly
 # stale) password itself.
 dc exec -T db psql -U postgres -c "ALTER USER postgres WITH PASSWORD '${DB_PASS}';" >/dev/null
}

psql-db() {
 dc exec -T db psql -X -U postgres -d "${1}" -tA -v ON_ERROR_STOP=1 "${@:2}"
}

# dbupdater's pgupgrade/pgdowngrade against the platform database, psql
# running inside the db container: pg <tool> <migrations dir> [options]
pg() {
 local tool="${1}"
 shift
 PSQL="docker compose -p mb-platform -f docker-compose.yml exec -T db psql" \
  "containers/${DBUPDATER_FOLDER}/${tool}" "${@}" -U postgres "${DB}"
}

sync-dbupdater() {
 sync-source "${DBUPDATER_REPO}" "${DBUPDATER_FOLDER}" "" >/dev/null || die "couldn't fetch dbupdater"
}

# "<database version> <latest version in the migrations dir>"
db-versions() {
 pg pgupgrade "${1:-${MIGRATIONS}}" --status
}

# The live database predates versioning: it has the CMS tables (version
# 001) but no version record. Before recording it as 001, check its
# structure really is what UP_001 creates -- built in a scratch database
# alongside and compared column by column, constraint by constraint.
adopt-unversioned-db() {
 local current has_cms has_atodo diff_out same scratch=mn_baseline_check
 read -r current _ <<< "$(db-versions)"
 [ "${current}" = "000" ] || return 0
 has_cms=$(psql-db "${DB}" -c "SELECT to_regclass('public.services') IS NOT NULL")
 [ "${has_cms}" = "t" ] || return 0 # an empty database: migrations create everything
 has_atodo=$(psql-db "${DB}" -c "SELECT EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = 'atodo')")
 if [ "${has_atodo}" = "t" ]; then
  echo "${0}: the unversioned database already has an atodo schema, which versioning can't vouch for." >&2
  echo "${0}: on a dev machine, rebuild it from the migrations with ./mn db reset." >&2
  return 1
 fi
 echo "${0}: unversioned database with the CMS tables -- checking it matches version 001"
 psql-db postgres -c "DROP DATABASE IF EXISTS ${scratch}" >/dev/null
 PSQL="docker compose -p mb-platform -f docker-compose.yml exec -T db psql" \
  "containers/${DBUPDATER_FOLDER}/pgupgrade" "${MIGRATIONS}" --ver 001 -U postgres "${scratch}" >/dev/null || return 1
 diff_out=$(diff <(psql-db "${DB}" < ./containers/postgres/catalog.sql) <(psql-db "${scratch}" < ./containers/postgres/catalog.sql))
 same=$?
 psql-db postgres -c "DROP DATABASE ${scratch}" >/dev/null
 if [ "${same}" -ne 0 ]; then
  echo "${0}: the database differs from version 001 (< database, > version 001):" >&2
  echo "${diff_out}" >&2
  return 1
 fi
 pg pgupgrade "${MIGRATIONS}" --baseline 001
}

db-backup() {
 local name="${1:-manual}" file
 mkdir -p "${BACKUP_DIR}"
 file="${BACKUP_DIR}/$(date +%Y%m%d-%H%M%S)_${name}.dump"
 if dc exec -T db pg_dump -U postgres -Fc "${DB}" > "${file}" && [ -s "${file}" ]; then
  echo "${0}: database backed up to ${file}"
 else
  rm -f "${file}"
  echo "${0}: database backup FAILED" >&2
  return 1
 fi
}

write-status() {
 # clientVersion: the atodo client that's live, so open tabs running an
 # older one offer a reload; announcement: an upcoming maintenance window.
 local announcement="${1}"
 if [ -n "${announcement}" ]; then
  printf '{"clientVersion":"%s","announcement":%s}\n' "${MN_VERSION}" "${announcement}" > "${MAINTENANCE_DIR}/status.json"
 else
  printf '{"clientVersion":"%s"}\n' "${MN_VERSION}" > "${MAINTENANCE_DIR}/status.json"
 fi
}

maintenance-on() {
 touch "${MAINTENANCE_DIR}/on"
 echo "${0}: maintenance mode ON -- pages show the maintenance page, API requests get 503 MAINTENANCE"
}

maintenance-off() {
 rm -f "${MAINTENANCE_DIR}/on"
 echo "${0}: maintenance mode off"
}

# Waits for the api to report itself in sync with the database, running
# the expected version.
wait-for-health() {
 local expect="${1}" body tries=0
 echo -n "${0}: waiting for the api to report healthy"
 while [ "${tries}" -lt 60 ]; do
  body=$(curl -s --max-time 3 "${HEALTH_URL}")
  if echo "${body}" | grep -q '"status":"ok"' && echo "${body}" | grep -q "\"version\":\"${expect}\""; then
   echo " ok"
   echo "${0}: ${body}"
   return 0
  fi
  echo -n "."
  tries=$((tries + 1))
  sleep 2
 done
 echo " timed out"
 echo "${0}: last /health answer: ${body:-none}" >&2
 return 1
}

# Keeps the images of the current and previous releases; removes the rest.
prune-images() {
 local keep1="${1}" keep2="${2}" svc tag
 for svc in "${PLATFORM_SERVICES[@]}"; do
  service-info "${svc}"
  for tag in $(docker images "${image}" --format '{{.Tag}}'); do
   [ "${tag}" = "${keep1}" ] || [ "${tag}" = "${keep2}" ] && continue
   docker rmi "${image}:${tag}" >/dev/null 2>&1
  done
 done
 docker image prune -f >/dev/null
}

deploy() {
 local version="${1}" label tag svc current latest now migrate=0 prev="${MN_VERSION}"
 # On a dev machine, versions with demo data get it as they're applied.
 local demo=()
 [ "${ENV}" = "dev" ] && demo=(--demo)
 if [ -n "${version}" ]; then
  [[ "${version}" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]+$ ]] || die "version must look like yyyy.MM.dd.x, e.g. 2026.09.27.1"
  label="${version}"
  tag="${version}"
  if [ "$(git describe --tags --exact-match 2>/dev/null)" != "${version}" ]; then
   echo "${0}: warning: this platform checkout (mn, compose, nginx config) isn't at tag ${version}"
  fi
 else
  label="dev-$(date +%Y%m%d%H%M%S)"
  tag=""
 fi
 echo "${0}: deploying ${label} (currently ${prev})"

 mkdir -p files/config files/postgres
 sync-dbupdater
 for svc in "${PLATFORM_SERVICES[@]}"; do
  service-info "${svc}"
  sync-source "${repo}" "${folder}" "${tag}" || die "couldn't check out ${svc}"
  deliver-config "${folder}" "$(printf '%s' "${svc}" | tr '[:lower:]' '[:upper:]')"
 done

 # Build everything first, while the current release keeps serving.
 for svc in "${PLATFORM_SERVICES[@]}"; do
  service-info "${svc}"
  echo "${0}: building ${image}:${label}"
  docker build -q --build-arg VERSION="${label}" -t "${image}:${label}" "containers/${folder}" >/dev/null \
   || die "building ${svc} failed -- nothing was changed"
 done

 wait-for-db
 adopt-unversioned-db || die "the database needs attention first -- nothing was changed"
 read -r current latest <<< "$(db-versions)"
 [ -n "${current}" ] || die "couldn't read the database version"
 if [ "$((10#${current}))" -gt "$((10#${latest}))" ]; then
  die "the database (version ${current}) is newer than ${label} expects (${latest}) -- use ./mn rollback to go back to an older release"
 fi
 [ "${current}" != "${latest}" ] && migrate=1

 if [ "${migrate}" -eq 1 ]; then
  echo "${0}: database ${current} -> ${latest}"
  maintenance-on
  dc stop api
  if ! db-backup "${prev}_to_${label}"; then
   dc start api
   maintenance-off
   die "no backup, no migration -- ${prev} is still running"
  fi
  if ! pg pgupgrade "${MIGRATIONS}" "${demo[@]}" --ver "${latest}"; then
   # Each version is its own transaction: the failing one changed nothing,
   # but earlier ones in the same run stay applied -- so the current release
   # can only come back if the database is still at the version it expects.
   read -r now _ <<< "$(db-versions)"
   if [ "${now}" = "${current}" ]; then
    dc start api
    maintenance-off
    die "migration failed; the database is unchanged and ${prev} is running again"
   fi
   die "migration failed at version ${now} (from ${current}); maintenance stays ON -- fix the failing migration and deploy again, or restore the backup (./mn db restore)"
  fi
 fi

 export MN_VERSION="${label}"
 dc up -d --force-recreate "${PLATFORM_SERVICES[@]}"
 if ! wait-for-health "${label}"; then
  [ "${migrate}" -eq 1 ] || maintenance-on
  echo "${prev}" > "${PREVIOUS_VERSION_FILE}"
  echo "${label}" > "${VERSION_FILE}"
  log-deploy "deploy ${label} (from ${prev}) UNHEALTHY"
  die "${label} isn't healthy (see ./mn logs api); maintenance is ON -- ./mn rollback returns to ${prev}"
 fi

 echo "${prev}" > "${PREVIOUS_VERSION_FILE}"
 echo "${label}" > "${VERSION_FILE}"
 write-status
 # A successful deploy ends maintenance -- whether it switched it on itself
 # or it was already on (by hand, or after a restore).
 [ -f "${MAINTENANCE_DIR}/on" ] && maintenance-off
 log-deploy "deploy ${label} (from ${prev}, database ${current} -> ${latest})"
 prune-images "${label}" "${prev}"
 echo "${0}: ${label} is live"
}

# Back to the release deployed before the current one: its images are still
# there (see prune-images), and if the database has migrations it doesn't
# know, they're reverted with their DOWN scripts (taken from the current
# release's api image) -- unless minAllowedVersion forbids it, in which case
# nothing changes and the way back is restoring a backup.
rollback() {
 local prev current expected dbv tmp cid svc
 prev=$(cat "${PREVIOUS_VERSION_FILE}" 2>/dev/null) || die "no previous release recorded"
 current="${MN_VERSION}"
 for svc in "${PLATFORM_SERVICES[@]}"; do
  service-info "${svc}"
  docker image inspect "${image}:${prev}" >/dev/null 2>&1 || die "image ${image}:${prev} is gone -- deploy ${prev} again instead"
 done
 echo "${0}: rolling back from ${current} to ${prev}"
 sync-dbupdater
 wait-for-db
 tmp=$(mktemp -d)
 cid=$(docker create "${API_CONTAINER}:${current}")
 docker cp "${cid}:/api/db/migrations" "${tmp}/" >/dev/null
 docker rm "${cid}" >/dev/null
 expected=$(docker run --rm --entrypoint sh "${API_CONTAINER}:${prev}" -c 'ls /api/db/migrations' \
  | sed -n 's/^UP_\([0-9]\{3\}\)_Version_.*\.sql$/\1/p' | sort | tail -1)
 read -r dbv _ <<< "$(db-versions "${tmp}/migrations")"
 [ -n "${expected}" ] && [ -n "${dbv}" ] || { rm -rf "${tmp}"; die "couldn't determine the database versions"; }

 local downgraded=0 floor
 floor=$(psql-db "${DB}" -c "SELECT settingValue FROM public.setting WHERE settingName = 'minAllowedVersion'")
 if [ "$((10#${dbv}))" -gt "$((10#${expected}))" ] && [ "$((10#${floor:-${dbv}}))" -gt "$((10#${expected}))" ]; then
  rm -rf "${tmp}"
  die "${prev} needs database version ${expected}, but this database can't go below ${floor:-${dbv}} (minAllowedVersion) -- nothing was changed. The way back is restoring a backup from before ${current} (./mn db restore)."
 fi
 if [ "$((10#${dbv}))" -gt "$((10#${expected}))" ]; then
  echo "${0}: database ${dbv} -> ${expected}"
  maintenance-on
  dc stop api
  db-backup "${current}_to_${prev}" || { dc start api; maintenance-off; rm -rf "${tmp}"; die "no backup, no downgrade -- ${current} is still running"; }
  if ! pg pgdowngrade "${tmp}/migrations" --ver "${expected}"; then
   read -r now _ <<< "$(db-versions "${tmp}/migrations")"
   rm -rf "${tmp}"
   if [ "${now}" = "${dbv}" ]; then
    dc start api
    maintenance-off
    die "the database can't be downgraded (see above -- minAllowedVersion?); ${current} is still running. The way back is restoring a backup from before ${current} (./mn db restore)."
   fi
   die "downgrade failed at version ${now}; maintenance stays ON -- restore a backup (./mn db restore)"
  fi
  downgraded=1
 fi
 rm -rf "${tmp}"

 export MN_VERSION="${prev}"
 dc up -d --force-recreate "${PLATFORM_SERVICES[@]}"
 if ! wait-for-health "${prev}"; then
  [ "${downgraded}" -eq 1 ] || maintenance-on
  die "${prev} isn't healthy either (see ./mn logs api); maintenance is ON"
 fi
 echo "${prev}" > "${VERSION_FILE}"
 rm -f "${PREVIOUS_VERSION_FILE}"
 write-status
 [ "${downgraded}" -eq 1 ] && maintenance-off
 log-deploy "rollback to ${prev} (from ${current})"
 echo "${0}: ${prev} is live again"
}

maintenance() {
 case "${1}" in
  on) maintenance-on;;
  off) maintenance-off;;
  announce)
   local start minutes
   start=$(date -d "${2}" --iso-8601=seconds 2>/dev/null) || die "usage: ${0} maintenance announce '<date time>' <minutes>"
   minutes="${3}"
   [[ "${minutes}" =~ ^[0-9]+$ ]] || die "usage: ${0} maintenance announce '<date time>' <minutes>"
   write-status "{\"start\":\"${start}\",\"minutes\":${minutes}}"
   echo "${0}: announced maintenance at ${start} (~${minutes} min) -- shown in open A-To-Do tabs within 5 minutes"
   ;;
  clear)
   write-status
   echo "${0}: announcement cleared"
   ;;
  status|"")
   [ -f "${MAINTENANCE_DIR}/on" ] && echo "maintenance: ON" || echo "maintenance: off"
   echo "status.json: $(cat "${MAINTENANCE_DIR}/status.json")"
   ;;
  *) die "usage: ${0} maintenance { on | off | announce '<date time>' <minutes> | clear | status }";;
 esac
}

db() {
 case "${1}" in
  status)
   sync-dbupdater
   wait-for-db >/dev/null
   read -r current latest <<< "$(db-versions)"
   echo "database '${DB}': version ${current}; latest in the checked-out api source: ${latest}"
   ;;
  backup)
   wait-for-db >/dev/null
   db-backup manual
   ;;
  restore)
   [ -f "${2}" ] || die "usage: ${0} db restore <backup file> (see ${BACKUP_DIR}/)"
   echo "${0}: restoring ${2} over database '${DB}' -- the api is stopped and maintenance is ON meanwhile"
   read -r -p "type 'restore' to continue: " answer
   [ "${answer}" = "restore" ] || die "cancelled"
   wait-for-db >/dev/null
   maintenance-on
   dc stop api
   dc exec -T db pg_restore -U postgres --clean --if-exists -d "${DB}" < "${2}" || die "restore reported errors (see above); maintenance stays ON"
   echo "${0}: restored; maintenance stays ON until you deploy the release that matches this database (./mn deploy <version>, or ./mn deploy on dev) -- that starts the api again and ends maintenance"
   ;;
  reset)
   # Dev only: rebuild the database from the migrations (plus demo data).
   [ "${ENV}" = "dev" ] || die "db reset is only for ENV=dev"
   echo "${0}: this DELETES everything in database '${DB}' and rebuilds it from ${MIGRATIONS} with demo data"
   read -r -p "type 'reset' to continue: " answer
   [ "${answer}" = "reset" ] || die "cancelled"
   sync-dbupdater
   service-info api
   sync-source "${repo}" "${folder}" "" >/dev/null || die "couldn't fetch the api source (for its migrations)"
   wait-for-db >/dev/null
   dc stop api
   psql-db "${DB}" -c "DROP SCHEMA IF EXISTS atodo CASCADE; DROP SCHEMA public CASCADE; CREATE SCHEMA public;" >/dev/null || die "reset failed"
   pg pgupgrade "${MIGRATIONS}" --demo --full || die "migrations failed"
   dc start api
   ;;
  upgrade|downgrade)
   # One version up or down, with the checked-out api source's migrations
   # (plus demo data on dev, as deploy does). Backs up first; the running
   # api isn't touched, so its /health reports the mismatch until the
   # matching release is deployed.
   local demo=()
   [ "${ENV}" = "dev" ] && demo=(--demo)
   [ -d "${MIGRATIONS}" ] || die "no migrations at ${MIGRATIONS} -- deploy once first"
   sync-dbupdater
   wait-for-db >/dev/null
   read -r current _ <<< "$(db-versions)"
   [ -n "${current}" ] || die "couldn't read the database version"
   db-backup "${1}_from_${current}" || die "no backup, no ${1}"
   pg "pg${1}" "${MIGRATIONS}" "${demo[@]}" || die "${1} failed; the database is still at version ${current}"
   read -r current latest <<< "$(db-versions)"
   echo "${0}: database '${DB}' is now at version ${current} (latest in the checked-out api source: ${latest})"
   ;;
  login)
   # An interactive psql inside the db container, logged in over TCP with
   # .env's credentials (so it also confirms they work).
   wait-for-db >/dev/null
   dc exec -e PGPASSWORD="${DB_PASS}" db psql -h 127.0.0.1 -U "${DB_USER:-postgres}" -d "${DB}"
   ;;
  *) die "usage: ${0} db { status | backup | restore <file> | reset | upgrade | downgrade | login }";;
 esac
}

status() {
 echo "release: ${MN_VERSION}$( [ -f "${PREVIOUS_VERSION_FILE}" ] && echo " (previous: $(cat "${PREVIOUS_VERSION_FILE}"))")"
 maintenance status
 echo "api /health: $(curl -s --max-time 3 "${HEALTH_URL}" || echo unreachable)"
 [ -f "${DEPLOY_LOG}" ] && { echo "recent deploys:"; tail -5 "${DEPLOY_LOG}" | sed 's/^/ /'; }
 dc ps
}

build-platform() {
 mkdir -p files/config files/postgres
 # bring old platform down; in the future this should be done with minimum downtime
 dc down
 # setup configs and certs
 # not envsubst: the template has no ${...} placeholders, and nginx's own
 # bare $variables (map, log_format, proxy_pass, ...) would get emptied out
 # by envsubst substituting anything that isn't a real env var
 cp "./containers/nginx/tlsoffloader.conf" "./files/config/tlsoffloader.conf"
 export DOMAINS=(${ALL_DOMAINS})
 export CERTFOLDER=certificates
 # this safely runs or skips certbot depending on ${ENV}
 . "./containers/certbot/letsencrypt-init.sh"
 letsencrypt-init
 # TEMPORARY setup for dnh.hr - its DNS zone lives in a separate GCP project,
 # so it needs its own dns-google credentials, not the platform's
 export DOMAINS=(dnh.hr *.dnh.hr)
 export DNS_CRED_CONTAINER_PATH=/dnh-cred.json
 letsencrypt-init
 cd containers
 rm -rf dnh-www
 git clone git@github.com:ReasonSharp/dnh-web.git "dnh-www"
 cd dnh-www
 docker build . -t mn-dnh
 cd ../..
 deliver-dnh-config
 # the platform's own services, database included (a fresh database is
 # created from the migrations -- on ENV=dev with demo data)
 deploy "${1}"
 # everything else
 dc up -d
 # TEMPORARY cleanup of dnh.hr
 rm -rf ./containers/dnh-www
}

rebuild-dnh() {
 export DOMAINS=(dnh.hr *.dnh.hr)
 . "./containers/certbot/letsencrypt-init.sh"
 export DOMAINS=(dnh.hr *.dnh.hr)
 export DNS_CRED_CONTAINER_PATH=/dnh-cred.json
 letsencrypt-init
 clone-or-pull git@github.com:ReasonSharp/dnh-web.git containers/dnh-www
 cd containers/dnh-www
 docker build . -t mn-dnh
 cd ../..
 deliver-dnh-config
 dc up -d dnhdb
 dc up -d dnh --force-recreate
}

update-one() {
 service="${1}"
 force="${2}"

 case "${service}" in
  api|www|admin|atodo)
   echo "${0}: the platform's services deploy together, with their database migrations: use ./mn deploy [version]"
   exit 1
   ;;
  db)
   echo "${0}: the database is migrated by ./mn deploy (see ./mn db for status/backup/restore/reset)"
   exit 1
   ;;
  tlsoffloader)
   # static config, not a cloned/built service - just reload it
   cp "./containers/nginx/tlsoffloader.conf" "./files/config/tlsoffloader.conf"
   dc up -d tlsoffloader --force-recreate
   ;;
  dnh)
   cd containers
   before=""
   [ -d dnh-www ] && before=$(git -C dnh-www rev-parse HEAD)
   clone-or-pull git@github.com:ReasonSharp/dnh-web.git dnh-www
   after=$(git -C dnh-www rev-parse HEAD)
   cd ..
   deliver-dnh-config
   if [ "${force}" -eq 1 ] || [ "${before}" != "${after}" ] || [ -z "$(docker images -q mn-dnh 2>/dev/null)" ]; then
    docker build containers/dnh-www -t mn-dnh
   else
    echo "${0}: dnh unchanged, skipping rebuild"
   fi
   dc up -d dnh --force-recreate
   ;;
  *)
   echo "usage: ${0} update [-f] { dnh | tlsoffloader }"
   exit 1
   ;;
 esac
}

update() {
 force=0
 if [ "${1}" = "-f" ]; then
  force=1
  shift
 fi

 if [ "${#}" -eq 0 ]; then
  echo "usage: ${0} update [-f] <service [service [service...]]>"
  exit 1
 fi

 for service in "${@}"; do
  update-one "${service}" "${force}"
 done
}

list-platform-containers() {
	dc ps ${@}
}

logs() {
	dc logs ${@}
}

exec() {
	dc exec -it ${@}
}

usage() {
 cat <<USAGE
Usage: ${0} COMMAND [params]

 deploy [version]    deploy a release (yyyy.MM.dd.x, tagged in every repo) or,
                     without one, every repo's main branch as dev-<timestamp>
 rollback            back to the previously deployed release
 status              deployed release, maintenance, api health, containers
 maintenance on|off  switch maintenance mode by hand
 maintenance announce '<date time>' <minutes>
                     announce upcoming maintenance to A-To-Do users
 maintenance clear   withdraw the announcement
 db status|backup|restore <file>|reset|upgrade|downgrade|login
                     database version, backup, restore, dev-only rebuild,
                     one version up/down, psql with .env's credentials
 build-platform [version]
                     set up everything from scratch (certificates, dnh, ...)
 update [-f] dnh|tlsoffloader
 rebuild-dnh
 ps | logs | exec    docker compose passthroughs
USAGE
}

cmd="${1}"
shift

case "${cmd}" in
 deploy)         deploy "${@}";;
 rollback)       rollback;;
 status)         status;;
 maintenance)    maintenance "${@}";;
 db)             db "${@}";;
 build-platform) build-platform "${@}";;
 rebuild-dnh)    rebuild-dnh;;
 update)         update "${@}";;
 ps)             list-platform-containers "${@}";;
 logs)           logs "${@}";;
 exec)           exec "${@}";;
 *)              usage;;
esac
