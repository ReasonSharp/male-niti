#!/bin/bash

immediateExit=0
if [ ! -f ./.env ]; then
 immediateExit=1
fi

set -a && . ./.env && set +a
envsubst < "./env.template" > "./.env"

if [ "${immediateExit}" -eq 1 ]; then
 echo ".env file created; edit it to configure the platform"
 exit 0
fi

PREFIX=mn
API_FOLDER=api
WWW_FOLDER=www
ADMIN_FOLDER=admin
export API_CONTAINER=${PREFIX}-${API_FOLDER}
export WWW_CONTAINER=${PREFIX}-${WWW_FOLDER}
export ADMIN_CONTAINER=${PREFIX}-${ADMIN_FOLDER}
mkdir -p ./files/config
if [ -z "${DNS_CRED_FULL_PATH}" ]; then
	export DNS_CREDENTIALS=
else
 cp "${DNS_CRED_FULL_PATH}" ./files/config/
 export DNS_CREDENTIALS=./files/config/$(basename "${DNS_CRED_FULL_PATH}")
fi

# platform-integration/{config.template,cfgloc} is a service repo's own
# contract with whatever platform deploys it, not something this platform
# owns - config.template is filled in from this platform's .env vars via
# envsubst, cfgloc is the single-line in-container path to bind-mount the
# result to. Renders into files/config/<folder>/ and exports
# <PREFIX>_CFG_SRC / <PREFIX>_CFG_DST for docker-compose.yml to bind-mount.
# Services whose repo doesn't provide a platform-integration/ folder are
# left alone. Call again after clone-or-pull so a freshly pulled contract
# takes effect immediately, not just on the next unrelated mn invocation.
deliver-config() {
 folder="${1}"
 varprefix="${2}"
 tmpl="containers/${folder}/platform-integration/config.template"
 cfgloc="containers/${folder}/platform-integration/cfgloc"
 if [ ! -f "${tmpl}" ] || [ ! -f "${cfgloc}" ]; then
  return
 fi
 dst=$(cat "${cfgloc}")
 mkdir -p "files/config/${folder}"
 src="files/config/${folder}/$(basename "${dst}")"
 envsubst < "${tmpl}" > "${src}"
 export "${varprefix}_CFG_SRC"="./${src}"
 export "${varprefix}_CFG_DST"="${dst}"
}

# dnh-web is a bolted-on site, not one of this platform's own services, so
# it has no platform-integration/ contract of its own; render its .env
# straight from a template this repo owns, since the mariadb creds it needs
# already live in this platform's .env. Must run after every (re)clone of
# dnh-www and before anything brings the dnh container up.
deliver-dnh-config() {
 envsubst < "containers/dnh-www.env.template" > "containers/dnh-www/.env"
}

deliver-config "${API_FOLDER}" API

clone-or-pull() {
 if [ -z "${1}" ] || [ -z "${2}" ]; then
  echo "clone-or-pull: missing parameter"
  exit 1
 fi
 link="${1}"
 path="${2}"
 branch="${3}"
 if [ ! -d "./${path}" ]; then
  if [ -z "${branch}" ]; then
   git clone "${link}" "${path}"
  else
   git clone -b "${branch}" "${link}" "${path}"
  fi
 else
 	prevPath=`pwd`
  cd "${path}"
  echo -n "${path}: "
  git pull
  cd "${prevPath}"
 fi
}

# Brings up the db container and, if it hasn't been initialized yet, loads
# containers/postgres/UP_001_20260723.sql into it. Safe to run repeatedly:
# if the schema is already present it is left as-is.
init-db() {
 docker compose -p mb-platform -f docker-compose.yml up -d db

 echo -n "${0}: waiting for db to accept connections"
 tries=0
 until docker compose -p mb-platform -f docker-compose.yml exec -T db pg_isready -U postgres >/dev/null 2>&1; do
  echo -n "."
  tries=$((tries + 1))
  if [ "${tries}" -ge 60 ]; then
   echo " timed out"
   exit 1
  fi
  sleep 1
 done
 echo " ready"

 # POSTGRES_PASSWORD only takes effect on first-time initdb, so on a data
 # dir that predates this container (or ${DB_PASS} changing since) the
 # actual role password can drift from .env. Keep it in sync on every run,
 # using the trusted local socket connection rather than the (possibly
 # stale) password itself.
 docker compose -p mb-platform -f docker-compose.yml exec -T db psql -U postgres -c "ALTER USER postgres WITH PASSWORD '${DB_PASS}';" >/dev/null

 initialized=$(docker compose -p mb-platform -f docker-compose.yml exec -T db psql -U postgres -tAc "SELECT to_regclass('public.services')")
 if [ -n "${initialized}" ]; then
  echo "${0}: db already initialized, leaving as-is"
  return
 fi

 echo "${0}: initializing db from containers/postgres/UP_001_20260723.sql"
 docker compose -p mb-platform -f docker-compose.yml exec -T db psql -U postgres < ./containers/postgres/UP_001_20260723.sql
}

build-platform() {
 mkdir -p files/config
 mkdir -p files/postgres
 # bring old platform down; in the future this should be done with minimum downtime
 docker compose -p mb-platform -f docker-compose.yml down
 # at the moment, just clone everything, in the future enable checking out individually
 # this has to happen before any docker compose invocation below: docker-compose.yml
 # references ${API_CFG_SRC}/${API_CFG_DST} unconditionally, and an empty value makes
 # every service's volume spec invalid, not just api's
 cd containers
 rm -rf "${API_FOLDER}" "${WWW_FOLDER}" "${ADMIN_FOLDER}"
 git clone git@github.com:ReasonSharp/male-niti-api.git "${API_FOLDER}"
 git clone git@github.com:ReasonSharp/male-niti-web.git "${WWW_FOLDER}"
 git clone git@github.com:ReasonSharp/male-niti-admin.git "${ADMIN_FOLDER}"
 cd ..
 deliver-config "${API_FOLDER}" API
 deliver-config "${WWW_FOLDER}" WWW
 deliver-config "${ADMIN_FOLDER}" ADMIN
 cd "containers/${API_FOLDER}"
 docker build . -t ${API_CONTAINER}
 cd "../${WWW_FOLDER}"
 docker build . -t ${WWW_CONTAINER}
 cd "../${ADMIN_FOLDER}"
 docker build . -t ${ADMIN_CONTAINER}
 cd ../..
 # setup configs and certs
 # not envsubst: the template has no ${...} placeholders, and nginx's own
 # bare $variables (map, log_format, proxy_pass, ...) would get emptied out
 # by envsubst substituting anything that isn't a real env var
 cp "./containers/nginx/tlsoffloader.conf" "./files/config/tlsoffloader.conf"
 export DOMAINS=(${ALL_DOMAINS})
 export CERTFOLDER=certificates
 # this safely runs or skips certbot depending on ${ENV}
 . "./containers/certbot/letsencrypt-init.sh"
 letsencrypt-init
 # TEMPORARY setup for dnh.hr
 export DOMAINS=(dnh.hr *.dnh.hr)
 letsencrypt-init
 cd containers
 rm -rf dnh-www
 git clone git@github.com:ReasonSharp/dnh-web.git "dnh-www"
 cd dnh-www
 docker build . -t mn-dnh
 cd ../..
 deliver-dnh-config
 # bring up platform
 docker compose -p mb-platform -f docker-compose.yml up -d
 init-db
 # TEMPORARY cleanup of dnh.hr
 rm -rf ./containers/dnh-www
 # cleanup
 docker system prune -a -f
}

rebuild-dnh() {
 export DOMAINS=(dnh.hr *.dnh.hr)
 . "./containers/certbot/letsencrypt-init.sh"
 export DOMAINS=(dnh.hr *.dnh.hr)
 letsencrypt-init
 clone-or-pull git@github.com:ReasonSharp/dnh-web.git containers/dnh-www
 cd containers/dnh-www
 docker build . -t mn-dnh
 cd ../..
 deliver-dnh-config
 docker compose -p mb-platform -f docker-compose.yml up -d dnhdb
 docker compose -p mb-platform -f docker-compose.yml up -d dnh --force-recreate
}

update-one() {
 service="${1}"
 force="${2}"

 if [ "${service}" = "db" ]; then
  init-db
  return
 fi

 case "${service}" in
  api)
   folder="${API_FOLDER}"
   image="${API_CONTAINER}"
   repo="git@github.com:ReasonSharp/male-niti-api.git"
   build_args=()
   ;;
  www)
   folder="${WWW_FOLDER}"
   image="${WWW_CONTAINER}"
   repo="git@github.com:ReasonSharp/male-niti-web.git"
   build_args=()
   ;;
  admin)
   folder="${ADMIN_FOLDER}"
   image="${ADMIN_CONTAINER}"
   repo="git@github.com:ReasonSharp/male-niti-admin.git"
   build_args=()
   ;;
  dnh)
   folder="dnh-www"
   image="mn-dnh"
   repo="git@github.com:ReasonSharp/dnh-web.git"
   build_args=()
   ;;
  *)
   echo "usage: ${0} update [-f] { api | www | admin | dnh | db }"
   exit 1
   ;;
 esac

 cd containers
 before=""
 if [ -d "${folder}" ]; then
  before=$(git -C "${folder}" rev-parse HEAD)
 fi
 clone-or-pull "${repo}" "${folder}"
 after=$(git -C "${folder}" rev-parse HEAD)
 cd ..

 deliver-config "${folder}" "$(printf '%s' "${service}" | tr '[:lower:]' '[:upper:]')"
 if [ "${service}" = "dnh" ]; then
  deliver-dnh-config
 fi

 if [ "${force}" -eq 1 ] || [ "${before}" != "${after}" ] || [ -z "$(docker images -q "${image}" 2>/dev/null)" ]; then
  cd "containers/${folder}"
  docker build "${build_args[@]}" . -t "${image}"
  cd ../..
 else
  echo "${0}: ${service} unchanged, skipping rebuild"
 fi

 docker compose -p mb-platform -f docker-compose.yml up -d "${service}" --force-recreate
}

update() {
 force=0
 if [ "${1}" = "-f" ]; then
  force=1
  shift
 fi

 if [ "${#}" -eq 0 ]; then
  echo "usage: ${0} update [-f] <service [service [service...]]>"
  exit 1
 fi

 for service in "${@}"; do
  update-one "${service}" "${force}"
 done
}

list-platform-containers() {
	docker compose -p mb-platform -f docker-compose.yml ps ${@}
}

logs() {
	docker compose -p mb-platform -f docker-compose.yml logs ${@}
}

exec() {
	docker compose -p mb-platform -f docker-compose.yml exec -it ${@}
}

cmd="${1}"
shift

case "${cmd}" in
 build-platform) build-platform;;
 rebuild-dnh)    rebuild-dnh;;
 update)         update "${@}";;
 ps)             list-platform-containers "${@}";;
 logs)           logs "${@}";;
 exec)           exec "${@}";;
 *) echo "Usage: ${0} COMMAND [params]"
esac

